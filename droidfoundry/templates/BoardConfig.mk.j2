# Generated by DroidFoundry
# Review every value before starting an actual ROM build.

DEVICE_PATH := device/{{ vendor }}/{{ device }}

# Architecture hints
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic

# Platform hints
TARGET_BOARD_PLATFORM := {{ metadata.platform if metadata.platform != "unknown" else "unknown" }}
TARGET_BOOTLOADER_BOARD_NAME := {{ device }}

# Kernel path hint
TARGET_KERNEL_SOURCE := kernel/{{ vendor }}/{{ device }}
TARGET_KERNEL_CONFIG := {{ device }}_defconfig

# Partitions detected from dump
{% for partition in scan.partitions %}# Detected partition: {{ partition }}
{% endfor %}

# Dynamic partitions and A/B flags are device-specific.
# DroidFoundry only writes a starting point here.
BOARD_BUILD_SYSTEM_ROOT_IMAGE := true
BOARD_USES_RECOVERY_AS_BOOT := false

# Vendor
BOARD_VENDOR := {{ vendor }}

# VINTF / Treble
PRODUCT_FULL_TREBLE_OVERRIDE := true

# Include proprietary vendor configuration
-include vendor/{{ vendor }}/{{ device }}/BoardConfigVendor.mk
